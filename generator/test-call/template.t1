package testcall

t1 showAll() {
	@a()
	@b(c("C"))
	@d()
	@showOne(e())
	@wrapChildren() {
		<div>Child content</div>
	}
}

t1 a() {
	<div>A</div>
}

t1 b(child tndr.Component) {
	<div>B</div>
	@child
}

t1 c(text string) {
	<div>{ text }</div>
}

t1 d() {
	<div>Legacy call style</div>
}

t1 e() {
	e
}

t1 showOne(component tndr.Component) {
	<div>
		@component
	</div>
}

t1 wrapChildren() {
	<div id="wrapper">
		{ children... }
	</div>
}
