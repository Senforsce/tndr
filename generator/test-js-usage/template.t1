package testjsusage

import "time"

var onceHandle = tndr.NewOnceHandle()

t1 TestComponent() {
	<button onClick={ tndr.JSFuncCall("alert", "Hello, World!") }>Click me</button>
	@onceHandle.Once() {
		<script>
			function customAlert(msg, date) {
				alert(msg + " " + date);
			}
		</script>
	}
	<button onClick={ tndr.JSFuncCall("customAlert", "Hello, custom alert 1: ", time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)) }>Click me</button>
	<button onClick={ tndr.JSFuncCall("customAlert", "Hello, custom alert 2: ", time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)) }>Click me</button>
	@tndr.JSFuncCall("customAlert", "Runs on page load", time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC))
	<script>
		function onClickEventHandler(event, data) {
			alert(event.type);
			alert(data);
			event.preventDefault();
		}
	</script>
	<button onclick={ tndr.JSFuncCall("onClickEventHandler", tndr.JSExpression("event"), "1234") }>Pass event handler</button>
}
