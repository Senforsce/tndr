package once

var helloHandle = tndr.NewOnceHandle()

t1 hello(label, name string) {
	@helloHandle.Once() {
		<script>
			function hello(name) {
				alert("Hello, " + name + "!");
			}
		</script>
	}
	<input type="button" value={ label } data-name={ name } onclick="hello(this.getAttribute('data-name'))"/>
}

t1 render() {
	@hello("Hello User", "user")
	@hello("Hello World", "world")
}
