package main

import "context"

func NameFromContext(ctx context.Context) string {
	if name, ok := ctx.Value("name").(string); ok && name != "" {
		return name
	}
	return "World"
}

t1 Home(name string) {
	<div>Hello { name }</div>
	<div>Hello { NameFromContext(ctx) } (from context)</div>
}

t1 NotFound() {
	<div>404</div>
}
