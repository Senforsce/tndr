-- fmt.t1 --
package test

import (
	"fmt"
	"github.com/senforsce/o/tr"
	"strconv"
)

t1 Hello(name string) {
	<div id={ strconv.Atoi("123") }>
		{ fmt.Sprintf("Hello, %s!", name) }
	</div>
}