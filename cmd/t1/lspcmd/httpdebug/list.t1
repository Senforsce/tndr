package httpdebug

t1 list(uris []string) {
	<table>
		<tr>
			<th>File</th>
			<th></th>
			<th></th>
			<th></th>
			<th></th>
		</tr>
		for _, uri := range uris {
			<tr class="test">
				<td>{ uri }</td>
				<td><a href={ getMapURL(uri) }>Mapping</a></td>
				<td><a href={ getSourceMapURL(uri) }>Source Map</a></td>
				<td><a href={ getTndrURL(uri) }>Tndr</a></td>
				<td><a href={ getGoURL(uri) }>Go</a></td>
			</tr>
		}
	</table>
}
