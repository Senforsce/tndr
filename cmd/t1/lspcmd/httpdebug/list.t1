package httpdebug

t1 list(uris []string) {
	<table>
		<tr>
			<th>File</th>
			<th></th>
			<th></th>
			<th></th>
			<th></th>
		</tr>
		for _, uri := range uris {
			<tr>
				<td class="Active">{ uri }</td>
				<td><a href={ getMapURL(uri) }>Mapping</a></td>
				<td><a href={ getSourceMapURL(uri) }>Source Map</a></td>
				<td><a href={ getT1URL(uri) }>T1</a></td>
				<td><a href={ getGoURL(uri) }>Go</a></td>
			</tr>
		}
	</table>
}
